# rules_python is required so hedron's refresh_compile_commands (which uses
# py_binary) resolves under Bazel's autoload. Matches mono/coreservices (8.5.1).
bazel_dep(name = "rules_python", version = "1.8.3")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")

# Compile commands for editor/clangd integration and `bazelisk run lint`.
# https://github.com/hedronvision/bazel-compile-commands-extractor
bazel_dep(name = "hedron_compile_commands", dev_dependency = False)
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    # Replace the commit hash (above) with the latest (https://github.com/hedronvision/bazel-compile-commands-extractor/commits/main).
)

# --- CI: hermetic LLVM toolchain + RBE platform support ---

bazel_dep(name = "toolchains_llvm", version = "1.7.0", dev_dependency = True)

LLVM_VERSION = "21.1.8"

llvm_toolchain_ext = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm_toolchain_ext.toolchain(
    name = "llvm_toolchain",
    llvm_version = LLVM_VERSION,
)
use_repo(llvm_toolchain_ext, "llvm_toolchain", "llvm_toolchain_llvm")
